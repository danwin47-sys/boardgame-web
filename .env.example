# 環境變數範本
# 複製此檔案為 .env 並填入實際值
# .env 不會被上傳到 GitHub

# ===== Flask 安全性設定 =====
# SECRET_KEY: Flask Session 加密金鑰（必須設定！）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_please_generate_a_random_one

# ===== LINE Login 設定 =====
# 從 LINE Developers Console 取得
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
# 本地開發: http://localhost:5000/auth/line/callback
# 生產環境: https://your-domain.com/auth/line/callback
LINE_CALLBACK_URL=http://localhost:5000/auth/line/callback

# ===== Google Sheets 設定 =====
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# ===== BGG API Token =====
# 從 BoardGameGeek 取得（可選，用於進階功能）
BGG_API_TOKEN=your_bgg_api_token_here

# ===== 管理員密碼 =====
# 請設定強密碼（至少 12 個字元，包含大小寫、數字、特殊符號）
ADMIN_PASSWORD=your_admin_password_here

# ===== 伺服器設定 =====
PORT=5000
HOST=0.0.0.0

# ===== 可選設定 =====
DEMO_MODE=False
LOG_LEVEL=INFO
FLASK_ENV=development
