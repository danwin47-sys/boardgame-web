# 環境變數範本
# 複製此檔案為 .env 並填入實際值
# .env 不會被上傳到 GitHub

# Google Sheets 設定
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# BGG API Token（從 BoardGameGeek 取得）
BGG_API_TOKEN=your_bgg_api_token_here

# 管理員密碼（請設定強密碼）
ADMIN_PASSWORD=your_admin_password_here

# 伺服器設定
PORT=5000
HOST=0.0.0.0

# 可選設定
DEMO_MODE=False
LOG_LEVEL=INFO
