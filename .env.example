# 環境變數配置範例
# 複製此檔案為 .env 並填入真實數值

# ===== Google Sheets 設定 =====
SHEET_URL=https://docs.google.com/spreadsheets/d/您的試算表ID/edit
GOOGLE_CREDENTIALS=您的_Google_憑證_JSON

# ===== 管理員設定 =====
ADMIN_PASSWORD=your_admin_password_here

# ===== 伺服器設定 =====
PORT=5000
HOST=0.0.0.0

# ===== BGG API 設定 =====
# 從 https://boardgamegeek.com/account/settings/bearer-tokens 取得
BGG_API_TOKEN=your_bgg_bearer_token_here

# DEMO_MODE: True = 使用演示數據, False = 使用真實 BGG API
DEMO_MODE=False

# BGG API 超時與重試設定
BGG_TIMEOUT=15
BGG_RETRIES=2

# ===== 快取設定 (秒) =====
GAMES_CACHE_TTL=30
MEMBERS_CACHE_TTL=3600
BGG_SEARCH_CACHE_TTL=300
BGG_DETAILS_CACHE_TTL=3600
BGG_HOT_CACHE_TTL=1800
