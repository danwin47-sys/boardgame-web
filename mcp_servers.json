{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP Servers Configuration for Boardgame-Web Agent",
  "servers": [
    {
      "name": "filesystem",
      "description": "Access to local filesystem operations",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "enabled": false,
      "env": {}
    },
    {
      "name": "github",
      "description": "GitHub API integration for repository management",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    {
      "name": "google-sheets",
      "description": "Google Sheets API integration (primary database)",
      "transport": "http",
      "url": "http://localhost:8000/mcp/sheets",
      "enabled": false,
      "env": {
        "GOOGLE_CREDENTIALS": "${GOOGLE_CREDENTIALS}"
      }
    },
    {
      "name": "brave-search",
      "description": "Web search using Brave Search API",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false,
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    {
      "name": "memory",
      "description": "Persistent memory storage for the agent",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": false,
      "env": {}
    },
    {
      "name": "puppeteer",
      "description": "Browser automation for testing UI",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": false,
      "env": {}
    },
    {
      "name": "sqlite",
      "description": "SQLite database for BGG Ranks local storage",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "./data/bgg_ranks/bgg_ranks.db"],
      "enabled": false,
      "env": {}
    }
  ]
}
